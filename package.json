{
	"name": "ndle-cloudflare-fileproxy",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy --env prod",
		"deploy:dev": "wrangler deploy --env dev",
		"deploy:prod": "wrangler deploy --env prod",
		"deploy:dry-run": "wrangler deploy --env prod --dry-run",
		"dev": "wrangler dev --env dev",
		"start": "wrangler dev --env dev",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --type-aware",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"check": "pnpm test && pnpm typecheck && pnpm lint && pnpm fmt:check",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@clerk/backend": "^3.33.0"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.9.2",
		"oxfmt": "^0.80.0",
		"oxlint": "^1.95.0",
		"oxlint-tsgolint": "^7.0.2008",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1",
		"wrangler": "^4.168.0"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@11.9.0"
}
